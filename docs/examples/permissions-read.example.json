{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyDiscovery",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity",
        "tag:GetResources",
        "ec2:DescribeAddresses", "ec2:DescribeVolumes", "ec2:DescribeSecurityGroups", "ec2:DescribeInstances",
        "cloudfront:GetDistribution", "cloudfront:GetDistributionConfig", "cloudfront:ListDistributions"
      ],
      "Resource": "*"
    }
  ]
}
